<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<style>
	.list-area {
		margin : auto;
		width : 90% !important;
		text-align : center;
	}

	.list-area>tbody>tr:hover {
		cursor : pointer;
	}
</style>
</head>
<body>

	<jsp:include page="../common/menubar.jsp" />
	
	<div class="outer">
		
		<br>
		<h2 align="center">일반게시판</h2>
		<br>
		
		<br><br>
		
		<!-- 검색창을 만들 부분 -->
		<div id="search-area" align="center"></div>
		
			<form action="" method="">
				
				<!-- 검색 시 검색 조건과 검색어를 입력받고 검색버튼을 클릭함!! -->
				<select>
					<option value="writer">작성자</option>
					<option value="title">제목</option>
					<option value="content">내용</option>
				</select>
				
				<input type="search" name="keyword">
				
				<button type="submit" class="btn btn-secondary btn-sm">검색</button>
			
			</form>
		
		<br><br>
		
		<!-- 게시글의 목록을 보여주는 부분 -->
		<table class="list-area table table-hover">
			<thead>
				<tr>
					<th>글번호</th>
					<th>카테고리</th>
					<th>글제목</th>
					<th>작성자</th>
					<th>조회수</th>
					<th>작성일</th>
				</tr>
			</thead>
			<tbody>
				<c:choose>
					<c:when test="${ empty requestScope.list }">
					
						<tr>
							<th colspan="6">
								조회된 게시글이 없습니다.
							</th>
						</tr>
					
					</c:when>
					<c:otherwise>
					
						<c:forEach var="b" items="${ requestScope.list }">
							
							<tr>
								<td>${ b.boardNo }</td>
								<td>${ b.category }</td>
								<td>${ b.boardTitle }</td>
								<td>${ b.boardWriter }</td>
								<td>${ b.count }</td>
								<td>${ b.createDate }</td>
							</tr>
							
						</c:forEach>
					
					</c:otherwise>
				</c:choose>
			</tbody>
		</table>

		<br><br>

		<!-- 페이징바 영역 -->
		<div class="paging-area">
		
			<ul class="pagination justify-content-center">
			
			  <c:choose>
			  	<c:when test="${ requestScope.pi.currentPage eq 1 }">
			  		<!-- 1 번 페이지일 경우 -->
			  		<li class="page-item disabled">
			  			<a class="page-link">Previous</a>
			  		</li>
			  	</c:when>
			  	<c:otherwise>	
				  <li class="page-item">
				  	<a class="page-link" href="/myweb/board/list?cpage=${ requestScope.pi.currentPage - 1 }">Previous</a>
				  </li>
			  	</c:otherwise>
			  </c:choose>
			
			  <c:forEach var="p" begin="${ requestScope.pi.startPage }"
			  					 end="${ requestScope.pi.endPage }" step="1">
			  					 
			  	<c:choose>
			  		<c:when test="${ requestScope.pi.currentPage eq p }">
			  			<!--
			  				현재 보고 있는 페이지라면 파란색으로 보이게끔 
			  				이 페이지로는 다시 이동 못하게끔 href 속성을 지워줌!!
			  			-->
			  			<li class="page-item active"><a class="page-link">${ p }</a></li>
			  		</c:when>
			  		<c:otherwise>
			  			<li class="page-item">
			  				<a class="page-link" href="/myweb/board/list?cpage=${ p }">${ p }</a>
			  			</li>
			  		</c:otherwise>
			  	</c:choose>
			  	
			  </c:forEach>
			  
			  <c:choose>
			  	<c:when test="${ requestScope.pi.currentPage eq requestScope.pi.maxPage }">
			  		<li class="page-item disabled">
					  <a class="page-link">Next</a>
					</li>
			  	</c:when>
			  	<c:otherwise>
			  		<li class="page-item">
					  <a class="page-link" href="/myweb/board/list?cpage=${ requestScope.pi.currentPage + 1 }">Next</a>
					</li>
			  	</c:otherwise>
			  </c:choose>
			  
			  
			</ul>
		</div>

		<br><br>

	</div>
	
	<br><br>

</body>
</html>